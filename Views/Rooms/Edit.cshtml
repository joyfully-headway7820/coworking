@model RoomFormViewModel
@{
    ViewData["Title"] = "Изменение помещения";
}

<h1>Изменение помещения</h1>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <partial name="_RoomForm" model="Model" />
</form>
<p><a asp-route="room-details" asp-route-id="@Model.Id">Отмена</a></p>
