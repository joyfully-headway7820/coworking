@model IReadOnlyList<ClientRowViewModel>
@{
    ViewData["Title"] = "Клиенты";
}

<h1>Клиенты</h1>
<p><a asp-action="Create">Новый клиент</a></p>

@if (Model.Count == 0)
{
    <p>Клиентов нет.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Почта</th>
                <th>Телефон</th>
                <th>Организация</th>
                <th>Бронирований</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>@client.Phone</td>
                    <td>@(client.Company ?? "—")</td>
                    <td>@client.BookingCount</td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@client.Id">Подробнее</a>
                        <a asp-route="client-bookings" asp-route-id="@client.Id">Бронирования</a>
                        <a asp-action="Edit" asp-route-id="@client.Id">Изменить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
