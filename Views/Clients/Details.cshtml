@model ClientDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<h1>@Model.FullName</h1>
<dl>
    <dt>Электронная почта</dt>
    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
    <dt>Телефон</dt>
    <dd>@Model.Phone</dd>
    <dt>Организация</dt>
    <dd>@(Model.Company ?? "—")</dd>
</dl>
<p class="actions">
    <a asp-action="Edit" asp-route-id="@Model.Id">Изменить</a>
    <a asp-route="client-bookings" asp-route-id="@Model.Id">Бронирования</a>
    <a asp-action="Index">К списку</a>
</p>

<h2>Бронирования</h2>
<partial name="_BookingLinks" model="Model.Bookings" />
